# Primer administrador: se crea al arrancar si la base no tiene usuarios.
# Copia este archivo como .env y cambia la contraseña antes de desplegar.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Pon 1 si la aplicación se sirve con HTTPS (cookie de sesión solo por HTTPS).
COOKIE_SEGURA=0
